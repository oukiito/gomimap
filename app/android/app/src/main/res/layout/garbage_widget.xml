<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp"
    android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:minHeight="48dp">
        <TextView android:id="@+id/widget_date" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#173E30" android:textStyle="bold" />
        <TextView android:id="@+id/widget_area" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#24684F" />
        <TextView android:id="@+id/widget_sample" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#654B16" android:paddingTop="4dp" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/widget_rows" android:layout_width="match_parent"
            android:layout_height="match_parent" android:divider="@null" android:scrollbars="vertical" />
        <TextView android:id="@+id/widget_empty" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="22sp" android:textColor="#173E30" />
    </FrameLayout>
</LinearLayout>
