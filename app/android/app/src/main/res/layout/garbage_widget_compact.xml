<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_date" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#173E30" android:textStyle="bold" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/widget_rows" android:layout_width="match_parent"
            android:layout_height="match_parent" android:divider="@null" android:scrollbars="vertical" />
        <TextView android:id="@+id/widget_empty" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="20sp" android:textColor="#173E30" />
    </FrameLayout>
</LinearLayout>
